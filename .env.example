# reid-worker environment overrides
#
# Copy this file to .env and fill in the values, OR set these in your shell /
# container environment. Any value set here OVERRIDES the matching entry in
# config.ini, so you can run the worker without committing a real config.ini.
#
# The worker talks to the database ONLY through the reid-db-handler API.
# It never opens a direct PostgreSQL connection.

# Enable the centralized reid-db-handler backend (true) or fall back to a
# local on-disk FAISS index (false).
REID_DB_ENABLED=true

# Base URL of the reid-db-handler API (no trailing slash). No hardcoded IPs:
# point this at wherever reid-db-handler runs (localhost, a service name, etc).
REID_DB_API_URL=http://localhost:9285

# API key for the reid-db-handler API. Generate on the reid-db-handler side.
REID_DB_API_KEY=

# Optional analytics endpoint URL. Leave blank if unused.
REID_ANALYTICS_URL=http://localhost:3400

# Log level: DEBUG, INFO, WARNING, ERROR.
REID_LOG_LEVEL=INFO

# Optional: HuggingFace token for downloading the Deep3DFaceRecon / BFM weights
# in fetch_models.sh (only needed for gated repos; the default repo is public).
# HF_TOKEN=
